[Unit]
Description=Zombie and Orphan Reaper Agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/zombie-reaper/agent.py
# Put ANTHROPIC_API_KEY=... in this file (chmod 600). Leading '-' = optional.
EnvironmentFile=-/etc/zombie-reaper.env
RuntimeDirectory=zombie-reaper
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
